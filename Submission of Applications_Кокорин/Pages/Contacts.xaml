<Page x:Class="Submission_of_Applications_Кокорин.Pages.Contacts"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Submission_of_Applications_Кокорин.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="410" d:DesignWidth="792"
      Title="Contacts">

    <Grid>
        <Grid Background="#F8F9FA">
            <Grid Margin="0,0,0,350" Background="White" Grid.ColumnSpan="3">
                <Image HorizontalAlignment="Left" Height="40" Margin="10,10,0,0" VerticalAlignment="Top" Width="40"/>
                <Label Content="Электронная приемная компания" HorizontalAlignment="Left" Margin="55,1,0,0" VerticalAlignment="Top" FontWeight="Bold"
    FontSize="19"/>
                <Label Content="Пермского авиационного техникума им. А. Д. Швецова" HorizontalAlignment="Left" Margin="55,24,0,0"
    VerticalAlignment="Top"/>
            </Grid>
            <Grid Margin="0,60,0,0" Grid.ColumnSpan="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Label Content="Контакты:" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
                <Label Content="Домашний номер:" HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top"/>
                <Label Content="Мобильный номер:" HorizontalAlignment="Left"  Margin="10,41,0,0" VerticalAlignment="Top" Grid.Column="1"/>
                <TextBox Height="24" Margin="10,67,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                <TextBox Height="24" Margin="10,67,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.Column="1"/>
                <Label Content="Электронный адрес:" HorizontalAlignment="Left" Margin="10,92,0,0" VerticalAlignment="Top"/>
                <TextBox Height="24" Margin="10,118,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
                
                <Button Content="Продолжить" HorizontalAlignment="Right" Margin="0,0,10,5" VerticalAlignment="Bottom" Width="150" Height="25" Grid.Column="2"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
