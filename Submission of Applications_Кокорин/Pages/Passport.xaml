<Page x:Class="Submission_of_Applications_Кокорин.Pages.Passport"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Submission_of_Applications_Кокорин.Pages"
      mc:Ignorable="d" d:DesignWidth="792"
      Title="Passport" Height="494">

    <Grid>
        <Grid Background="#F8F9FA" Margin="0,0,0,-115">
            <Grid Margin="0,0,0,350" Background="White" Grid.ColumnSpan="3">
