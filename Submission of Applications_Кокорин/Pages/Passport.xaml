                <TextBox Height="24" Margin="10,67,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                <TextBox Height="24" Margin="10,67,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.Column="1"/>
                <TextBox Height="24" Margin="10,67,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.Column="2"/>
                <Label Content="Дата рождения:" HorizontalAlignment="Left" Margin="10,92,0,0" VerticalAlignment="Top"/>
                <TextBox Height="24" Margin="10,118,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
                <Label Content="Гражданство:" HorizontalAlignment="Left" Margin="10,143,0,0" VerticalAlignment="Top"/>
                <TextBox Height="24" Margin="10,169,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
                <Label Content="Место рождения:" HorizontalAlignment="Left" Margin="10,194,0,0" VerticalAlignment="Top"/>
                <TextBox Height="24" Margin="10,220,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
                <Label Content="Серия и номер паспорта:" HorizontalAlignment="Left" Margin="10,245,0,0" VerticalAlignment="Top"/>
                <Label Content="Дата выдачи:" HorizontalAlignment="Left"  Margin="10,245,0,0" VerticalAlignment="Top" Grid.Column="1"/>
                <Label Content="Код подразделения:" HorizontalAlignment="Left" Margin="10,245,0,0" VerticalAlignment="Top" Grid.Column="2"/>
                <TextBox Height="24" Margin="10,271,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>
                <TextBox Height="24" Margin="10,271,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.Column="1"/>
                <TextBox Height="24" Margin="10,271,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.Column="2"/>
                <Label Content="Кем выдан:" HorizontalAlignment="Left" Margin="10,296,0,0" VerticalAlignment="Top"/>
                <TextBox Height="24" Margin="10,321,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
                <Label Content="Адрес по прописке:" HorizontalAlignment="Left" Margin="10,346,0,0" VerticalAlignment="Top"/>
                <Label Content="Район:" HorizontalAlignment="Left"  Margin="10,346,0,0" VerticalAlignment="Top" Grid.Column="2"/>
                <TextBox Height="24" Margin="10,371,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                <TextBox Height="24" Margin="10,371,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.Column="2"/>
                <Label Content="Адрес проживания фактический:" HorizontalAlignment="Left" Margin="10,396,0,0" VerticalAlignment="Top"/>
                <Label Content="Район:" HorizontalAlignment="Left"  Margin="10,396,0,0" VerticalAlignment="Top" Grid.Column="2"/>
                <TextBox Height="24" Margin="10,421,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                <TextBox Height="24" Margin="10,421,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.Column="2"/>
                <Label Content="Прикрепите сканы страниц паспорта с фотографией и действующей пропиской" HorizontalAlignment="Left" 
        Margin="8,445,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
                <Label Content="(Формат документов должен быть PNG, JPEG или PDF, а максимальный размер каждого файла 5 МБ)" HorizontalAlignment="Left" Margin="18,467,0,0" VerticalAlignment="Top"
        Background="{x:Null}" FontSize="10" Foreground="Red" Grid.ColumnSpan="2"/>
                <TextBox Height="24" Margin="10,490,107,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.ColumnSpan="3"/>
                <Button Content="Выбрать..." HorizontalAlignment="Right" Margin="0,0,10,35" VerticalAlignment="Bottom" Height="24" Width="90" Grid.Column="2"/>
                <Button Content="Продолжить" HorizontalAlignment="Right" Margin="0,0,10,5" VerticalAlignment="Bottom" Width="150" Height="25" Grid.Column="2"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
